# Cloudflare Pages: dejar vacío. Las salas usan el mismo dominio del juego.
VITE_MULTIPLAYER_SERVER_URL=

# Solo en el servicio Node: origen exacto de la web, sin / al final ni rutas.
# Varios orígenes separados por comas. No se incluye ninguna clave privada.
# Solo para pruebas con el servidor Node opcional.
ALLOWED_ORIGINS=
